# Local development (backend on your machine):
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Production: these are read at BUILD time, so they must be set in your host's
# build env (Vercel/Netlify Project Settings → Environment Variables), then the
# frontend must be REBUILT. A committed .env does not reach the host build.
#   VITE_API_URL=https://<your-backend>.onrender.com
#   VITE_WS_URL=wss://<your-backend>.onrender.com
# The URL must be the FastAPI backend — GET /health should return
# {"status":"ok","version":"0.1.0"} (not an Express "Cannot GET" 404).
