<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<title>ARGUS Analyst Report - {{ session_id[:8] }}</title>
<style>
  @page {
    size: A4;
    margin: 18mm 16mm 18mm 16mm;
    @bottom-right {
      content: "ARGUS - Page " counter(page) " of " counter(pages);
      color: #667085;
      font-size: 9px;
    }
  }
  :root {
    --ink: #111827;
    --muted: #667085;
    --line: #d0d5dd;
    --panel: #f8fafc;
    --blue: #0b5cad;
    --critical: #b42318;
    --high: #c2410c;
    --medium: #b7791f;
    --low: #175cd3;
    --info: #475467;
  }
  * { box-sizing: border-box; }
  body {
    color: var(--ink);
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 11px;
    line-height: 1.52;
    margin: 0;
  }
  h1, h2, h3 { margin: 0; }
  h1 { font-size: 28px; letter-spacing: 0.04em; }
  h2 {
    border-bottom: 1px solid var(--line);
    color: var(--blue);
    font-size: 15px;
    letter-spacing: 0.08em;
    margin: 22px 0 11px;
    padding-bottom: 5px;
    text-transform: uppercase;
  }
  h3 { font-size: 12px; line-height: 1.35; margin-bottom: 6px; }
  p { margin: 0 0 9px; }
  table { border-collapse: collapse; width: 100%; }
  th, td {
    border-bottom: 1px solid #eaecf0;
    padding: 7px 8px;
    text-align: left;
    vertical-align: top;
  }
  th {
    color: #344054;
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .cover {
    border-bottom: 4px solid var(--blue);
    display: flex;
    justify-content: space-between;
    padding-bottom: 18px;
  }
  .brand { color: var(--blue); font-family: Consolas, monospace; font-weight: 700; }
  .subtitle { color: var(--muted); font-size: 12px; margin-top: 4px; }
  .meta { color: var(--muted); font-size: 10px; text-align: right; }
  .meta strong { color: var(--ink); }
  .panel {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 6px;
    break-inside: avoid;
    margin-bottom: 12px;
    padding: 13px;
  }
  .grid-2 { display: grid; gap: 10px; grid-template-columns: 1fr 1fr; }
  .grid-3 { display: grid; gap: 8px; grid-template-columns: repeat(3, 1fr); }
  .grid-5 { display: grid; gap: 7px; grid-template-columns: repeat(5, 1fr); }
  .metric {
    border: 1px solid var(--line);
    border-radius: 6px;
    break-inside: avoid;
    padding: 10px;
  }
  .metric .value { font-family: Consolas, monospace; font-size: 21px; font-weight: 700; }
  .metric .label { color: var(--muted); font-size: 9px; letter-spacing: 0.06em; text-transform: uppercase; }
  .risk {
    align-items: center;
    display: flex;
    gap: 14px;
  }
  .risk-score {
    border: 4px solid var(--blue);
    border-radius: 50%;
    font-family: Consolas, monospace;
    font-size: 28px;
    font-weight: 700;
    height: 82px;
    line-height: 74px;
    text-align: center;
    width: 82px;
  }
  .badge {
    border: 1px solid currentColor;
    border-radius: 4px;
    display: inline-block;
    font-family: Consolas, monospace;
    font-size: 9px;
    font-weight: 700;
    padding: 1px 5px;
    text-transform: uppercase;
  }
  .critical { color: var(--critical); }
  .high { color: var(--high); }
  .medium { color: var(--medium); }
  .low { color: var(--low); }
  .info { color: var(--info); }
  .small { color: var(--muted); font-size: 9px; }
  .mono { font-family: Consolas, monospace; }
  .break { word-break: break-word; }
  .chain, .finding {
    border: 1px solid var(--line);
    border-left: 4px solid var(--blue);
    border-radius: 6px;
    break-inside: avoid;
    margin-bottom: 12px;
    padding: 12px;
    page-break-inside: avoid;
  }
  .section-lead {
    color: #344054;
    font-size: 10px;
    margin-bottom: 11px;
  }
  .summary-list {
    margin: 0;
    padding-left: 16px;
  }
  .summary-list li { margin-bottom: 6px; }
  .finding.critical { border-left-color: var(--critical); }
  .finding.high { border-left-color: var(--high); }
  .finding.medium { border-left-color: var(--medium); }
  .finding.low { border-left-color: var(--low); }
  .finding.info { border-left-color: var(--info); }
  .chain-path {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin: 8px 0;
  }
  .step {
    background: #eef4ff;
    border: 1px solid #b2ccff;
    border-radius: 4px;
    color: #1849a9;
    font-family: Consolas, monospace;
    font-size: 9px;
    padding: 3px 5px;
  }
  .scorebar {
    background: #eaecf0;
    border-radius: 999px;
    height: 6px;
    margin-top: 3px;
    overflow: hidden;
  }
  .scorebar > span { background: var(--blue); display: block; height: 100%; }
  .evidence {
    background: #fcfcfd;
    border: 1px solid #eaecf0;
    border-radius: 5px;
    margin-top: 8px;
    padding: 7px;
  }
  .evidence-row {
    display: grid;
    gap: 8px;
    grid-template-columns: 110px 1fr;
    margin-bottom: 4px;
  }
  .reasoning {
    background: #fff;
    border: 1px dashed #cbd5e1;
    border-radius: 5px;
    margin-top: 8px;
    padding: 8px;
  }
  .footer-note {
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 9px;
    margin-top: 18px;
    padding-top: 8px;
  }
</style>
</head>
<body>
<section class="cover">
  <div>
    <h1 class="brand">ARGUS</h1>
    <div class="subtitle">Structured Analyst Threat Report - Vulnerability Severity, Reasoning, and Attack Chain Overview</div>
  </div>
  <div class="meta">
    <div><strong>Session:</strong> {{ session_id }}</div>
    <div><strong>Generated:</strong> {{ generated_at }}</div>
    <div><strong>Mode:</strong> {{ target.mode | default("unknown") }}</div>
  </div>
</section>

<h2>Executive Overview</h2>
<div class="panel risk">
  <div class="risk-score">{{ risk_score }}</div>
  <div>
    <h3>Overall analyst rating: <span class="badge {{ risk_rating | lower }}">{{ risk_rating }}</span></h3>
    <p>{{ analyst_verdict }}</p>
    <ul class="summary-list">
      {% for item in executive_summary %}
      <li>{{ item }}</li>
      {% endfor %}
    </ul>
    {% if top_chain %}
    <p><strong>Top chain:</strong> {{ top_chain.rating }} at {{ top_chain.priority_pct }}% priority across {{ top_chain.step_findings | length }} step(s).</p>
    {% else %}
    <p><strong>Top chain:</strong> No exploit chain was generated for this analysis.</p>
    {% endif %}
    <p class="small">Risk score weights maximum severity, confirmed exploitability, and affected-layer breadth. Confidence and decision evidence are shown per finding.</p>
  </div>
</div>

<div class="grid-3">
  <div class="metric"><div class="value">{{ total_findings }}</div><div class="label">Total findings</div></div>
  <div class="metric"><div class="value">{{ exploitable_count }}</div><div class="label">Exploitable</div></div>
  <div class="metric"><div class="value">{{ chains | length }}</div><div class="label">Attack chains</div></div>
</div>

<h2>Target Context</h2>
<div class="panel">
  <table>
    <tbody>
      <tr><th>Primary target</th><td class="break">{{ target_label }}</td></tr>
      {% if target.url %}<tr><th>URL</th><td class="mono break">{{ target.url }}</td></tr>{% endif %}
      {% if target.llm_endpoint %}<tr><th>LLM endpoint</th><td class="mono break">{{ target.llm_endpoint }}</td></tr>{% endif %}
      {% if target.description %}<tr><th>Description</th><td>{{ target.description }}</td></tr>{% endif %}
      <tr><th>Domains hit</th><td>{{ domains_hit | join(", ") if domains_hit else "None" }}</td></tr>
    </tbody>
  </table>
</div>

<h2>Scope and Methodology</h2>
<div class="panel">
  <p class="section-lead">This report is generated from persisted ARGUS session artifacts and normalizes findings, chains, and validation evidence into a review-ready structure.</p>
  <ul class="summary-list">
    {% for note in methodology_notes %}
    <li>{{ note }}</li>
    {% endfor %}
  </ul>
</div>

<h2>Severity Distribution</h2>
<div class="grid-5">
  <div class="metric"><div class="value critical">{{ counts.critical }}</div><div class="label">Critical</div></div>
  <div class="metric"><div class="value high">{{ counts.high }}</div><div class="label">High</div></div>
  <div class="metric"><div class="value medium">{{ counts.medium }}</div><div class="label">Medium</div></div>
  <div class="metric"><div class="value low">{{ counts.low }}</div><div class="label">Low</div></div>
  <div class="metric"><div class="value info">{{ counts.info }}</div><div class="label">Info</div></div>
</div>

<h2>Layer Coverage</h2>
<table>
  <thead>
    <tr><th>Layer</th><th>Domain</th><th>Findings</th><th>Exploitable</th><th>Highest signal</th></tr>
  </thead>
  <tbody>
    {% for row in layer_summary %}
    <tr>
      <td>L{{ row.layer }} - {{ row.name }}</td>
      <td>{{ row.domain }}</td>
      <td>{{ row.count }}</td>
      <td>{{ row.exploitable }}</td>
      <td>{% if row.highest %}<span class="badge {{ row.highest.severity }}">{{ row.highest.severity }}</span> {{ row.highest.title }}{% else %}<span class="small">No finding</span>{% endif %}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

{% if chains %}
<h2>Attack Chain Walkthrough</h2>
<p class="section-lead">Chains are ordered by ARGUS priority and show where a defender can break the path fastest.</p>
{% for chain in chains %}
<section class="chain">
  <div style="display:flex; justify-content:space-between; gap:10px;">
    <h3>Chain {{ loop.index }} - {{ chain.rating }}</h3>
    <span class="badge {{ 'critical' if chain.priority >= 0.85 else 'high' if chain.priority >= 0.70 else 'medium' }}">{{ chain.priority_pct }}% priority</span>
  </div>
  <p>{{ chain.narrative }}</p>
  <div class="reasoning">
    <strong>Reasoning path:</strong> <span class="mono break">{{ chain.path_label }}</span><br/>
    <strong>Analyst note:</strong> {{ chain.reasoning_summary }}
  </div>
  <div class="chain-path">
    {% for f in chain.step_findings %}
    <span class="step">L{{ f.layer }} {{ f.layer_name }} - {{ f.severity | upper }}</span>
    {% endfor %}
  </div>
  <div class="grid-3">
    <div><strong>Exploitability</strong><div class="scorebar"><span style="width: {{ chain.exploitability_pct }}%"></span></div><span class="small">{{ chain.exploitability_pct }}%</span></div>
    <div><strong>Impact</strong><div class="scorebar"><span style="width: {{ chain.impact_pct }}%"></span></div><span class="small">{{ chain.impact_pct }}%</span></div>
    <div><strong>Novelty</strong><div class="scorebar"><span style="width: {{ chain.novelty_pct }}%"></span></div><span class="small">{{ chain.novelty_pct }}%</span></div>
  </div>
  {% if chain.remediations %}
  <h3 style="margin-top:10px;">Chain Breakpoints</h3>
  <table>
    <thead><tr><th>Layer</th><th>Action</th><th>Reference</th></tr></thead>
    <tbody>
      {% for r in chain.remediations %}
      <tr><td>L{{ r.layer }}</td><td>{{ r.action }}</td><td class="mono">{{ r.ref }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}
</section>
{% endfor %}
{% endif %}

<h2>Finding Detail and Analyst Rating</h2>
<p class="section-lead">Findings are sorted by severity and confidence. Evidence excerpts are intentionally compact to preserve PDF readability.</p>
{% for f in findings %}
<section class="finding {{ f.severity }}">
  <div style="display:flex; justify-content:space-between; gap:10px;">
    <h3>{{ f.title }}</h3>
    <span class="badge {{ f.severity }}">{{ f.severity }}</span>
  </div>
  <table>
    <tbody>
      <tr><th>Layer</th><td>L{{ f.layer }} - {{ f.layer_name }} ({{ f.layer_domain }})</td></tr>
      <tr><th>Rating rationale</th><td>{{ f.severity_rationale }}</td></tr>
      <tr><th>Confidence</th><td>{{ f.confidence_pct }}%<div class="scorebar"><span style="width: {{ f.confidence_pct }}%"></span></div></td></tr>
      <tr><th>Decision</th><td>{% if f.decision_reason %}{{ f.decision_strength | title }} - {{ f.decision_reason }}{% else %}Layer reported finding; no central decision note recorded.{% endif %}</td></tr>
      <tr><th>References</th><td>{% if f.owasp_ref %}<span class="mono">{{ f.owasp_ref }}</span>{% endif %}{% if f.mitre_ref %} <span class="mono">{{ f.mitre_ref }}</span>{% endif %}</td></tr>
    </tbody>
  </table>
  {% if f.evidence_items %}
  <div class="evidence">
    <h3>Evidence</h3>
    {% for item in f.evidence_items %}
    <div class="evidence-row"><div class="small mono">{{ item.key }}</div><div class="break">{{ item.value }}</div></div>
    {% endfor %}
  </div>
  {% endif %}
</section>
{% else %}
<p class="small">No findings recorded.</p>
{% endfor %}

<h2>Remediation Priority Plan</h2>
<div class="panel">
  {% if chains and top_chain and top_chain.remediations %}
  <p><strong>Start with the top chain.</strong> Breaking any early step in the highest-priority chain can reduce total exploitability fastest.</p>
  <table>
    <thead><tr><th>Priority</th><th>Layer</th><th>Action</th><th>Reference</th></tr></thead>
    <tbody>
      {% for r in top_chain.remediations %}
      <tr><td>{{ loop.index }}</td><td>L{{ r.layer }}</td><td>{{ r.action }}</td><td class="mono">{{ r.ref }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <p>No chain remediation plan was generated. Triage critical and high exploitable findings first, then address medium hardening issues.</p>
  {% endif %}
</div>

{% if audit_log %}
<h2>Terminal Validation Audit</h2>
<table>
  <thead><tr><th>Timestamp</th><th>Command</th><th>Status</th><th>Reason</th></tr></thead>
  <tbody>
    {% for entry in audit_log %}
    <tr>
      <td class="mono">{{ entry.ts | default("") }}</td>
      <td class="mono break">{{ entry.command | default("") }}</td>
      <td>{{ entry.status | default("") }}</td>
      <td>{{ entry.reason | default("") }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

<div class="footer-note">
  ARGUS v0.1.0 - This report is intended for authorized security assessment. Validate high-impact findings before production remediation or disclosure.
</div>
</body>
</html>
